# Reverse proxy in front of the app. SITE_ADDRESS is a hostname (e.g. 3-91-12-34.sslip.io)
# to get automatic Let's Encrypt HTTPS, or ":80" for plain HTTP. The app has its own sign-in,
# so Caddy adds no login of its own.

{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:8080
}
